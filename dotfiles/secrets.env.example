# 敏感 / 个人专属环境变量的模板
#
# 用法：
#   mkdir -p ~/.config
#   cp dotfiles/secrets.env.example ~/.config/secrets.env
#   chmod 600 ~/.config/secrets.env
#   然后把下面的占位值换成真的
#
# ~/.zshrc 里有一行会自动 source 它，所以这些变量不会出现在这个仓库的任何文件中。

# Codex CLI 的 BYOK key
export VFWD_API_KEY="填入你的 key"

# Apple Developer ID 签名身份（codesign 用）。
# 只有装了该证书的机器需要；格式见 `security find-identity -v -p codesigning`
export SAYYO_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
